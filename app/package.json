{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:lan": "powershell -ExecutionPolicy Bypass -File scripts/start-expo-lan.ps1",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "diagnose:expo": "powershell -ExecutionPolicy Bypass -File scripts/diagnose-expo.ps1",
    "firewall:expo": "powershell -ExecutionPolicy Bypass -File scripts/open-firewall-expo.ps1",
    "launch:check": "powershell -ExecutionPolicy Bypass -File scripts/launch-check.ps1",
    "beta:preflight": "powershell -ExecutionPolicy Bypass -File scripts/beta-preflight.ps1",
    "beta:server": "powershell -ExecutionPolicy Bypass -File scripts/beta-server.ps1",
    "server:stripe": "powershell -ExecutionPolicy Bypass -File scripts/stripe-dev.ps1",
    "server:onefootball": "python -m uvicorn main:app --app-dir server/onefootball --host 0.0.0.0 --port 8010 --reload",
    "server:youtube": "python -m uvicorn main:app --app-dir server/youtube --host 0.0.0.0 --port 8011 --reload",
    "stripe:configure": "powershell -ExecutionPolicy Bypass -File scripts/configure-stripe.ps1",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,database,storage",
    "firebase:list:databases": "node scripts/listFirestoreDatabases.mjs",
    "firebase:test:publish": "node scripts/testFirebasePublish.mjs",
    "build:preview:ios": "npx eas-cli@latest build --profile preview --platform ios",
    "build:preview:android": "npx eas-cli@latest build --profile preview --platform android",
    "build:prod:ios": "npx eas-cli@latest build --profile production --platform ios",
    "build:prod:android": "npx eas-cli@latest build --profile production --platform android",
    "assets:placeholders": "node scripts/generate-placeholder-assets.mjs",
    "assets:kits": "node scripts/generate-national-kits.mjs",
    "sounds:generate": "node scripts/generateHubSounds.mjs",
    "sounds:download": "node scripts/downloadHubSounds.mjs",
    "theme:blue": "node scripts/apply-blue-theme.mjs",
    "theme:soft-blue": "node scripts/soften-blue-theme.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.21.0",
    "@react-navigation/stack": "^7.8.9",
    "@stripe/stripe-react-native": "0.81.0",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.16.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-auth-session": "~58.0.14",
    "expo-av": "~16.0.8",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "firebase": "^12.12.1",
    "i18next": "^26.3.0",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "soccer-jersey": "^1.0.14",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "firebase-tools": "^14.0.0",
    "jsdom": "^29.1.1",
    "linkedom": "^0.18.12",
    "payment-icons": "^1.2.1",
    "typescript": "~6.0.3"
  }
}
