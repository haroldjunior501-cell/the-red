PORT=4242

# Dashboard Stripe → Développeurs → Clés API (mode Test)
STRIPE_SECRET_KEY=sk_test_...
# Optionnel en local (fulfill via l’app après paiement). Obligatoire en prod.
STRIPE_WEBHOOK_SECRET=whsec_...
# Compte de service Firebase (console > Paramètres > Comptes de service > Générer une clé)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# ou JSON sur une ligne :
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Simulator Arena (Live Score + Firebase RTDB)
LIVESCORE_KEY=
LIVESCORE_SECRET=
# ou reprendre les clés Expo :
# EXPO_PUBLIC_LIVESCORE_KEY=
# EXPO_PUBLIC_LIVESCORE_SECRET=
FIREBASE_DATABASE_URL=
SIMULATOR_ENABLED=true
SIMULATOR_POLL_MS=45000
SIMULATOR_ADMIN_SECRET=change-me-in-production
# Tests avant le 11 juin 2026 : SIMULATOR_FORCE_LIVE=true
# SIMULATOR_FORCE_LIVE=false
#
# App : EXPO_PUBLIC_LAUNCH_MODE=1 dans .env racine pour débloquer Arena + Tableau KO en test interne.
