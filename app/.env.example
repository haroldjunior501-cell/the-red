# Copie en `.env` à la racine de GOALYA/app et remplis (sans guillemets, sans espaces autour du =).

EXPO_PUBLIC_AVATARSDK_CLIENT_ID=
EXPO_PUBLIC_AVATARSDK_CLIENT_SECRET=

# Optionnel — iframe MetaPerson
# EXPO_PUBLIC_METAPERSON_IFRAME_URL=https://mobile.metaperson.avatarsdk.com/generator

# API GOALYA (serveur Stripe FP — dossier server/)
# Ex. http://localhost:4242 ou https://api.tondomaine.com
EXPO_PUBLIC_API_URL=

# Stripe — clé publique (pk_test_… ou pk_live_…)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Firebase — Paramètres du projet > Général > SDK setup (Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Google — IDs OAuth (même projet Firebase : Authentication > Sign-in method > Google)
# Mobile (obligatoire sur iPhone/Android) : récupère les IDs dans Firebase > Google > SDK iOS / Android
# Web (navigateur uniquement) : client « Application Web »
# Le proxy https://auth.expo.io est obsolète — l’app utilise le schéma goalya://oauthredirect (app.json > scheme)
# Pour un development build : configure les clients iOS/Android dans Google Cloud / Firebase
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Football — Live Score API uniquement (Coupe du monde 2026). Voir https://live-score-api.com/world-cup-api
EXPO_PUBLIC_LIVESCORE_KEY=
EXPO_PUBLIC_LIVESCORE_SECRET=

# Giphy — stickers animés dans Mon Armée (developers.giphy.com)
EXPO_PUBLIC_GIPHY_API_KEY=

# Mapbox — jeton PUBLIC uniquement (commence par pk.eyJ…), une ligne, SANS guillemets ni espaces autour du =.
# Après modification : npx expo start -c (Metro recharge les EXPO_PUBLIC_*).
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Pages légales (app mondiale) — base https://goalya.app par défaut
EXPO_PUBLIC_LEGAL_BASE_URL=https://goalya.app
# EXPO_PUBLIC_LEGAL_PRIVACY_URL=
# EXPO_PUBLIC_LEGAL_TERMS_URL=
# EXPO_PUBLIC_LEGAL_PRIVACY_POLICY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=support@goalya.app

# Mode démo désactivé — données live/Firebase uniquement.
# EXPO_PUBLIC_GAMES_SIMULATION=0
# EXPO_PUBLIC_HUB_SIMULATION=0

# Pré-lancement / test interne : débloque Arena, Tableau KO local, Simulator live côté app.
# À retirer ou passer à 0 en production stricte avant la CdM si besoin.
EXPO_PUBLIC_LAUNCH_MODE=1
# EXPO_PUBLIC_SIMULATOR_FORCE_LIVE=1
