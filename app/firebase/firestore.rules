rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    match /users/{userId} {

      allow read, write: if request.auth != null && request.auth.uid == userId;



      match /fcmTokens/{tokenId} {

        allow read, write: if request.auth != null && request.auth.uid == userId;

      }



      match /missions/daily {

        allow read, write: if request.auth != null && request.auth.uid == userId;

      }



      match /fantasy_transactions/{txId} {

        allow read, write: if request.auth != null && request.auth.uid == userId;

      }



      match /fantasy/team {

        allow read, write: if request.auth != null && request.auth.uid == userId;

      }



      match /games/{gameId} {

        allow read, write: if request.auth != null && request.auth.uid == userId;

      }

    }



    match /fantasy_teams/{userId} {

      allow read: if request.auth != null;

      allow write: if request.auth != null && request.auth.uid == userId;

    }



    match /pronos/{matchId} {

      allow read: if request.auth != null;

      match /aggregates/{scoreKey} {

        allow read: if request.auth != null;

        allow create, update: if request.auth != null

          && request.resource.data.keys().hasAll(['score', 'count'])

          && request.resource.data.score is string

          && request.resource.data.count is int

          && request.resource.data.count >= 1

          && request.resource.data.count <= 500000;

      }

    }



    match /duel_waiting/{userId} {

      allow read: if request.auth != null;

      allow create, update, delete: if request.auth != null && request.auth.uid == userId;

    }



    match /duels/{duelId} {

      allow read: if request.auth != null

        && (resource.data.player1.userId == request.auth.uid

          || resource.data.player2.userId == request.auth.uid);

      allow create: if request.auth != null

        && (request.resource.data.player1.userId == request.auth.uid

          || request.resource.data.player2.userId == request.auth.uid);

      allow update: if request.auth != null

        && (resource.data.player1.userId == request.auth.uid

          || resource.data.player2.userId == request.auth.uid);

      allow delete: if false;

    }



    match /simulator/{seasonId}/rankings/{userId} {

      allow read: if request.auth != null;

      allow write: if false;

    }



    match /content_stories/{id} {

      allow read: if true;

      allow write: if request.auth != null

        && request.auth.token.admin == true;

    }

    match /content_videos/{id} {

      allow read: if true;

      allow write: if request.auth != null

        && request.auth.token.admin == true;



      match /likes/{userId} {

        allow read: if true;

        allow create: if request.auth != null && request.auth.uid == userId;

        allow delete: if request.auth != null && request.auth.uid == userId;

        allow update: if false;

      }

    }

  }

}


